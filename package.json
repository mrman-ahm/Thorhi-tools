{
  "name": "throhi-production",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/prepare-cinematic-assets.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/prepare-cinematic-assets.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:media": "node --test tests/media-*.test.mjs",
    "test:e2e": "playwright test",
    "verify:redesign": "bash scripts/verify-full-redesign.sh",
    "backend:check": "node --test tests/inquiry-durable-backend.test.mjs",
    "readiness:check": "node scripts/check-production-readiness.mjs",
    "data:process": "node scripts/process-catalogue.mjs",
    "data:finemed": "node scripts/import-finemed-catalogue.mjs && node scripts/prepare-product-media.mjs",
    "data:media": "node scripts/prepare-product-media.mjs",
    "data:approve": "node scripts/promote-approved-catalogue.mjs",
    "media:sources": "node scripts/media/register-catalogue-sources.mjs",
    "media:audit:placements": "node scripts/media/audit-placement-map.mjs",
    "media:audit:products": "node scripts/media/audit-product-media.mjs",
    "media:audit:report": "node scripts/media/build-media-audit-report.mjs",
    "media:audit": "npm run media:sources && npm run media:audit:placements && npm run media:audit:products && npm run media:audit:report"
  },
  "dependencies": {
    "animejs": "4.5.0",
    "next": "15.4.4",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "1.61.1",
    "@types/node": "^22.16.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "eslint": "^9.31.0",
    "eslint-config-next": "15.4.4",
    "fflate": "0.8.3",
    "sharp": "0.35.3",
    "typescript": "^5.8.3"
  }
}
