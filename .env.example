# Durable inquiry Worker URL, for example https://throhi-inquiry-api.<account>.workers.dev
INQUIRY_API_URL=

# Must exactly match the Worker INQUIRY_API_SECRET secret.
INQUIRY_API_SECRET=

# Independent high-entropy secret used to hash request fingerprints before forwarding.
INQUIRY_FINGERPRINT_SECRET=

# Optional. Configure together with TURNSTILE_SECRET_KEY on the Worker.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
